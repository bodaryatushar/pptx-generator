{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "pptx-jsx",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "pptx-jsx": ["./src/index.ts"],
      "pptx-jsx/jsx-runtime": ["./src/jsx-runtime.ts"]
    }
  },
  "include": ["src"]
}
